@page
@model UI_Razor.Pages.Report.RevenueReportModel
@{
    ViewData["Title"] = "Báo cáo doanh thu";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container py-4">
    <h2 class="mb-4 text-primary">📊 Báo cáo doanh thu</h2>

    <!-- Bộ lọc thời gian -->
    <form method="get" class="row g-3 align-items-end mb-4">
        <div class="col-md-2">
            <label class="form-label">Ngày</label>
            <input type="number" asp-for="Day" min="1" max="31" class="form-control" placeholder="Ngày" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Tháng</label>
            <input type="number" asp-for="Month" min="1" max="12" class="form-control" placeholder="Tháng" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Năm</label>
            <input type="number" asp-for="Year" min="2000" max="2100" class="form-control" placeholder="Năm" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Xem báo cáo
            </button>
        </div>
    </form>

    <!-- Thông tin tổng quan -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-success h-100">
                <div class="card-body">
                    <h5 class="card-title">Tổng doanh thu</h5>
                    <p class="card-text fs-4">@Model.Summary.TotalRevenue.ToString("N0") VND</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info h-100">
                <div class="card-body">
                    <h5 class="card-title">Số đơn hàng</h5>
                    <p class="card-text fs-4">@Model.Summary.TotalOrders</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning h-100">
                <div class="card-body">
                    <h5 class="card-title">Top sản phẩm bán chạy</h5>
                    <p class="card-text fs-5">@Model.Summary.TopProductName (@Model.Summary.TopProductSold)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách đơn hàng -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            Danh sách đơn hàng
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Người mua</th>
                        <th>Ngày tạo</th>
                        <th>Tổng tiền</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Reports)
                    {
                        <tr>
                            <td>@item.OrderId</td>
                            <td>@item.Name</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>@item.TotalAmount.ToString("N0") VND</td>
                            <td>
                                <a asp-page="./RevenueReport"
                                   asp-route-Day="@Model.Day"
                                   asp-route-Month="@Model.Month"
                                   asp-route-Year="@Model.Year"
                                   asp-route-orderId="@(Model.SelectedOrderId == item.OrderId ? null : item.OrderId)"
                                   class="btn btn-sm @(Model.SelectedOrderId == item.OrderId ? "btn-danger" : "btn-outline-primary")">
                                    @(Model.SelectedOrderId == item.OrderId ? "Đóng" : "Chi tiết")
                                </a>
                            </td>
                        </tr>

                        @if (Model.OrderDetails != null && item.OrderId == Model.SelectedOrderId)
                        {
                            <tr>
                                <td colspan="5" class="bg-light">
                                    <h5 class="mt-3">Chi tiết đơn hàng #@item.OrderId</h5>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mt-2">
                                            <thead class="table-secondary">
                                                <tr>
                                                    <th>Sản phẩm</th>
                                                    <th>Size</th>
                                                    <th>Số lượng</th>
                                                    <th>Đơn giá</th>
                                                    <th>SĐT</th>
                                                    <th>Địa chỉ</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var detail in Model.OrderDetails)
                                                {
                                                    <tr>
                                                        <td>@detail.Product.Name</td>
                                                        <td>@detail.Size</td>
                                                        <td>@detail.Quantity</td>
                                                        <td>@detail.Price.ToString("N0") VND</td>
                                                        <td>@detail.PhoneNumber</td>
                                                        <td>@detail.Address</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Biểu đồ doanh thu -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            Biểu đồ doanh thu theo ngày
        </div>
        <div class="card-body">
            <canvas id="revenueChart" height="100"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var ctx = document.getElementById('revenueChart').getContext('2d');
    var revenueChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.Reports.Select(r => r.CreatedAt.ToString("dd/MM")))),
            datasets: [{
                label: 'Doanh thu',
                data: @Html.Raw(Json.Serialize(Model.Reports.Select(r => r.TotalAmount))),
                backgroundColor: 'rgba(54, 162, 235, 0.6)',
                borderRadius: 5
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            let value = context.raw.toLocaleString('vi-VN') + ' VND';
                            return value;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return value.toLocaleString('vi-VN') + ' VND';
                        }
                    }
                }
            }
        }
    });
</script>
