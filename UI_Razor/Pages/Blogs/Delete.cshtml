@page
@model UI_Razor.Pages.Blogs.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Blog</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Blog.BlogTitle)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Blog.BlogTitle)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Blog.BlogContent)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Blog.BlogContent)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Blog.BlogImg)
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.Blog.BlogImg" alt="Blog Image" style="max-width: 200px;" />
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Blog.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Blog.CreatedAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Blog.User)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Blog.User.Email)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Blog.BlogId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
