@page
@model UI_Razor.Pages.Blogs.CreateModel
@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<h4>Blog</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Blog.UserId" class="control-label"></label>
                <select asp-for="Blog.UserId" class="form-control" asp-items="ViewBag.UserId"></select>
                <span asp-validation-for="Blog.UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Blog.BlogTitle" class="control-label"></label>
                <input asp-for="Blog.BlogTitle" class="form-control" />
                <span asp-validation-for="Blog.BlogTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Blog.BlogContent" class="control-label"></label>
                <textarea asp-for="Blog.BlogContent" class="form-control"></textarea>
                <span asp-validation-for="Blog.BlogContent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BlogImg" class="control-label">Blog Image</label>
                <input type="file" asp-for="BlogImg" class="form-control" accept=".jpg,.jpeg,.png,.gif" required />
                <span asp-validation-for="BlogImg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}