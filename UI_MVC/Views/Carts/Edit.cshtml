@model DAL.Models.Cart

@{
    ViewData["Title"] = "Edit";
}
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

<h1 class="text-2xl font-bold mb-4 text-center">Cart</h1>

<hr />
<div class="container d-flex justify-content-center">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow p-4" style="width: 200%;">
                <form id="editForm" asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="CartId" />
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div class="d-flex align-items-center mb-3">
                        <label for="size" class="mr-2">Chọn kích thước:</label>
                        <div class="input-group" style="width: 150px;">
                            <div class="input-group-prepend">
                                <button class="btn btn-outline-secondary btn-decrease" type="button">−</button>
                            </div>
                            <input type="text" id="size" name="Size" class="form-control text-center" value="@Model.Size" readonly>
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary btn-increase" type="button">+</button>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="quantity">Số lượng:</label>
                        <input type="number" id="quantity" name="Quantity" class="form-control" min="1" value="@Model.Quantity">
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="successModalLabel">Thông báo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Nội dung thông báo sẽ được cập nhật qua JavaScript -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelector(".btn-increase").addEventListener("click", function () {
                let sizeElement = document.getElementById("size");
                let currentSize = parseFloat(sizeElement.value); // Lấy giá trị hiện tại
                if (currentSize < 22.0) { // Kiểm tra xem có nhỏ hơn 22 cm không
                    currentSize += 0.5; // Tăng thêm 0.5 cm
                    sizeElement.value = currentSize.toFixed(1) + " cm"; // Cập nhật giá trị
                }
            });

            document.querySelector(".btn-decrease").addEventListener("click", function () {
                let sizeElement = document.getElementById("size");
                let currentSize = parseFloat(sizeElement.value); // Lấy giá trị hiện tại
                if (currentSize > 10.0) { // Kiểm tra xem có lớn hơn 10 cm không
                    currentSize -= 0.5; // Giảm đi 0.5 cm
                    sizeElement.value = currentSize.toFixed(1) + " cm"; // Cập nhật giá trị
                }
            });

            document.getElementById("editForm").addEventListener("submit", function (event) {
                event.preventDefault(); // Ngăn chặn hành động mặc định của form

                $.ajax({
                    type: "POST",
                    url: $(this).attr("action"),
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            $('#successModal .modal-body').text(response.message);
                            $('#successModal').modal('show');
                        } else {
                            $('#successModal .modal-body').text(response.message);
                            $('#successModal').modal('show');
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = "Đã xảy ra lỗi trong quá trình xử lý yêu cầu.";
                        if (xhr.responseText) {
                            errorMessage = xhr.responseText; // Lấy lỗi từ Server (nếu có)
                        }
                        $('#successModal .modal-body').text(errorMessage);
                        $('#successModal').modal('show');
                    }
                });
            });
        });
    </script>
}
