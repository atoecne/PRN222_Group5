@using DAL.Models
@model CheckoutViewModel

@{
    ViewData["Title"] = "Xác nhận đơn hàng";
}
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

<div class="row">
    <div class="col-md-6">
        <h3>Thông tin khách hàng</h3>
        <form asp-controller="OrderDetails" asp-action="SaveOrderDetail" method="post">
            <input type="hidden" asp-for="OrderId" />

            <div class="form-group">
                <label>Họ và Tên*</label>
                <input type="text" name="UserName" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Số điện thoại*</label>
                <input type="text" name="PhoneNumber" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Địa chỉ*</label>
                <input type="text" name="Address" class="form-control" required />
            </div>

            <button type="button" id="btnSubmit" class="btn btn-success">Xác nhận đặt hàng</button>
        </form>
    </div>

    @if (Model?.CartItems != null && Model.CartItems.Any())
    {
        <div class="col-md-6">
            <h3>Giỏ hàng của bạn</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Sản phẩm</th>
                        <th>Size</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr data-cart-id="@item.CartId" data-product-id="@item.ProductId" data-size="@item.Size">
                        @* <tr data-product-id="@item.ProductId" data-size="@item.Size"> *@
                            <td><img src="@item.ProductImg" alt="@item.ProductName" width="50" /></td>
                            <td>@item.ProductName</td>
                            <td>@item.Size</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("C")</td>
                            <td>@item.TotalPrice.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <h4>Tổng tiền: @Model.CartItems.Sum(c => c.TotalPrice).ToString("C")</h4>
        </div>
    }
    else
    {
        <p>Giỏ hàng của bạn trống.</p>
    }
</div>



<div class="modal fade" id="notificationModal" tabindex="-1" role="dialog" aria-labelledby="notificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg rounded-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="notificationModalLabel">Thông báo</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                <p id="notificationMessage" class="mt-3 font-weight-bold"></p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary px-4 py-2" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Cập nhật CSS để popup trông đẹp hơn -->
<style>
    .modal-content {
        border-radius: 12px;
    }

    .modal-header {
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }

    .modal-footer {
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
    }
</style>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
 

<script>
    $(document).ready(function() {
        $('#notificationModal').modal('hide');
    });
    document.getElementById("btnSubmit").addEventListener("click", async function () {
        let orderId = "@(Model?.OrderId ?? 0)";
        if (orderId == "0") {
            showNotification("❌ Lỗi: Không có OrderId hợp lệ!");
            return;
        }

                let customerData = {
            UserName: document.querySelector("input[name='UserName']").value.trim(),
            PhoneNumber: document.querySelector("input[name='PhoneNumber']").value.trim(),
            Address: document.querySelector("input[name='Address']").value.trim()
        };

    let nameRegex = /^[\p{L} ]+$/u; 
    let phoneRegex = /^[0-9]{10,11}$/;

    if (!customerData.UserName || !nameRegex.test(customerData.UserName)) {
        showNotification("❌ Vui lòng nhập Họ và Tên hợp lệ (chỉ chứa chữ cái)!");
        return;
    }

    if (!customerData.PhoneNumber || !phoneRegex.test(customerData.PhoneNumber)) {
        showNotification("❌ Vui lòng nhập số điện thoại hợp lệ (10-11 chữ số)!");
        return;
    }

    if (!customerData.Address) {
        showNotification("❌ Vui lòng nhập Địa chỉ!");
        return;
    }


        let checkoutData = {
            OrderId: parseInt(orderId), // Chắc chắn OrderId là số
            CartItems: []
        }; 

        document.querySelectorAll("tbody tr").forEach(row => {
            let cartId = parseInt(row.dataset.cartId) || 0;
            let productId = parseInt(row.dataset.productId) || 0;
            let size = row.dataset.size || "";
            let quantity = parseInt(row.children[3].textContent.trim()) || 0;
            let unitPriceText = row.children[4].textContent.trim();
            let unitPrice = parseFloat(unitPriceText.replace(/[^\d.]/g, "")) || 0;
            let totalPrice = parseFloat(row.children[5].textContent.replace(/[₫,]/g, "").trim()) || 0;

            if (productId > 0 && quantity > 0) { // Chỉ thêm nếu dữ liệu hợp lệ
                checkoutData.CartItems.push({ ProductId: productId, Size: size, Quantity: quantity, UnitPrice: unitPrice, TotalPrice: totalPrice });
            }
        });

        if (!customerData.UserName || !customerData.PhoneNumber || !customerData.Address) {
            alert("❌ Vui lòng nhập đầy đủ thông tin khách hàng!");
            return;
        }
            
        let payload = JSON.stringify({ CheckoutData: checkoutData, CustomerData: customerData });

        console.log("📤 Gửi dữ liệu:", payload); // Kiểm tra JSON trước khi gửi

        try {
            let response = await fetch("/OrderDetails/SaveOrderDetail", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: payload
            });

            let responseText = await response.text(); // Lấy phản hồi dưới dạng văn bản
    console.log("Phản hồi từ server:", responseText); // Kiểm tra phản hồi

    let result;
    try {
        result = JSON.parse(responseText); // Cố gắng phân tích cú pháp thành JSON
    } catch (e) {
        throw new Error("Phản hồi không phải là JSON hợp lệ");
    }

            if (response.ok) {
                showNotification("✅ Đặt hàng thành công!");
                setTimeout(() => {
                window.location.href = `/OrderDetails/Index?orderId=${orderId}`;
            }, 2000);
            } else {
                showNotification("❌ Lỗi: " + (result.message || "Không thể đặt hàng"));
            }
        } catch (error) {
            showNotification("❌ Lỗi kết nối đến server: " + error.message);
        }
    });
    function showNotification(message, isSuccess = true) {
        if (!message || message.trim() === "") return;
        $('#notificationModal').modal('hide');
        document.getElementById("notificationMessage").innerHTML = message;

        let modalHeader = document.querySelector(".modal-header");
        let icon = document.querySelector(".modal-body i");

        if (isSuccess) {
            modalHeader.classList.replace("bg-danger", "bg-success");
            icon.classList.replace("fa-times-circle", "fa-check-circle");
            icon.classList.add("text-success");
        } else {
            modalHeader.classList.replace("bg-success", "bg-danger");
            icon.classList.replace("fa-check-circle", "fa-times-circle");
            icon.classList.add("text-danger");
        }

        setTimeout(() => {
        $('#notificationModal').modal('show');
    }, 100);
    }

</script>
