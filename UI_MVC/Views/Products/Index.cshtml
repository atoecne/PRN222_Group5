@model IEnumerable<DAL.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h1>Danh sách sản phẩm</h1>

<p>
    <a asp-controller="Carts" asp-action="Index" class="btn btn-primary">
        <i class="fas fa-shopping-cart"></i> View Cart
    </a>
</p>

<div class="container">
    <div class="row">
        @foreach (var item in Model.Where(p => p.Active))
        {
            <div class="col-md-4 mb-4">
                <div class="card" onclick="window.location.href='@Url.Action("Details", "Products", new { id = item.ProductId })'">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body text-center">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Name)</h5>
                        <p class="card-text">@Html.DisplayFor(modelItem => item.Price)đ</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet" />
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

